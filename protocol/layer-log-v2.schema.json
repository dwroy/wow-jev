{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-jev:layer-log-v2",
  "title": "严格四层日志与世界/知识来源 v2",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "wow-layer-log"
    },
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "manifest",
        "task_start",
        "layer_observation",
        "behavior_selection_request",
        "behavior_selection_result",
        "behavior_start",
        "behavior_hazard_preempt",
        "behavior_state",
        "behavior_action_intent",
        "layer_command_link",
        "body_action_intent",
        "body_native_receipt",
        "body_action_outcome",
        "behavior_action_result",
        "behavior_result",
        "task_checkpoint",
        "task_result",
        "body_release",
        "layer_hand_ready",
        "layer_shutdown",
        "layer_final_result",
        "layer_control",
        "layer_error",
        "layer_knowledge_consultation"
      ]
    },
    "data": {
      "$ref": "#/$defs/json"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "protocol",
    "version",
    "run_id",
    "seq",
    "at_ms",
    "previous_sha256",
    "kind",
    "data",
    "sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sqlite_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "directory": {
          "const": "world"
        }
      },
      "required": [
        "manifest_sha256",
        "sqlite_sha256",
        "directory"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "quest",
            "creature",
            "game_object",
            "item",
            "spell",
            "area_trigger",
            "ui_map",
            "world_map",
            "map_floor",
            "instance",
            "achievement"
          ]
        },
        "native_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "namespace",
        "kind",
        "native_id"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "world_pack_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "quest_key": {
          "$ref": "#/$defs/entity"
        },
        "assertion_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "native_objective_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "world_pack_sha256",
        "quest_key",
        "assertion_sha256",
        "ordinal",
        "native_objective_id"
      ],
      "additionalProperties": false
    },
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1048576
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          },
          "maxItems": 50000
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          },
          "maxProperties": 10000
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "audit_version": {
          "const": "layer-evidence-v2"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "world": {
          "$ref": "#/$defs/world"
        },
        "client_version": {
          "$ref": "urn:wow-jev:game-data-v1#/$defs/version"
        },
        "runtime": {
          "$ref": "#/$defs/ref"
        },
        "knowledge": {
          "$ref": "#/$defs/ref"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_profile": {
          "type": "object"
        },
        "clock": {
          "type": "object",
          "properties": {
            "domain": {
              "enum": [
                "simulation-monotonic",
                "coordinator-monotonic"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "domain",
            "id"
          ],
          "additionalProperties": false
        },
        "task": {
          "type": "object"
        },
        "run_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quest_episode": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "phase": {
              "enum": [
                "accept",
                "objective",
                "deliver"
              ]
            },
            "quest_key": {
              "$ref": "#/$defs/entity"
            },
            "objective_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/objective"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "phase",
            "quest_key",
            "objective_ref"
          ],
          "additionalProperties": false
        },
        "actor": {
          "type": "object",
          "properties": {
            "character_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "account_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "class": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "spec": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "level": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 128,
              "uniqueItems": true
            }
          },
          "required": [
            "character_id",
            "account_id",
            "class",
            "spec",
            "level",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "route_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "world_task_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "supporting_eye": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "directory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "events_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "directory",
                "manifest_sha256",
                "events_sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "automatic_action_eligible": {
          "const": false
        }
      },
      "required": [
        "schema_version",
        "audit_version",
        "mode",
        "started_at",
        "world",
        "client_version",
        "runtime",
        "knowledge",
        "code_sha256",
        "prompts_sha256",
        "body_profile_sha256",
        "bindings_sha256",
        "calibration_sha256",
        "body_profile",
        "clock",
        "task",
        "run_epoch",
        "quest_episode",
        "actor",
        "route_revision",
        "world_task_plan_sha256",
        "supporting_eye",
        "automatic_action_eligible"
      ],
      "additionalProperties": false
    }
  }
}
