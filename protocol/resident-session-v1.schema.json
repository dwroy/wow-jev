{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-resident:protocol:session-v1",
  "title": "Bounded session-1 resident WGC and input transport v1",
  "oneOf": [
    {
      "$ref": "#/definitions/command"
    },
    {
      "$ref": "#/definitions/ready"
    },
    {
      "$ref": "#/definitions/sample"
    },
    {
      "$ref": "#/definitions/receipt"
    },
    {
      "$ref": "#/definitions/evidence"
    },
    {
      "$ref": "#/definitions/stopped"
    },
    {
      "$ref": "#/definitions/error"
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ticks": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "hwnd": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,16}$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "const": "windows-qpc"
        },
        "at_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "domain",
        "at_ms"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "start_ticks": {
          "$ref": "#/definitions/ticks"
        },
        "hwnd": {
          "$ref": "#/definitions/hwnd"
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "windows_session_id": {
          "const": 1
        }
      },
      "required": [
        "pid",
        "start_ticks",
        "hwnd",
        "class",
        "executable",
        "windows_session_id"
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        },
        "top": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        },
        "right": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        },
        "bottom": {
          "type": "integer",
          "minimum": -65536,
          "maximum": 65536
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hwnd": {
          "$ref": "#/definitions/hwnd"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "client_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "client_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "focused": {
          "type": "boolean"
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "start_ticks": {
          "$ref": "#/definitions/ticks"
        },
        "dpi": {
          "type": "integer",
          "minimum": 48,
          "maximum": 768
        },
        "visible": {
          "type": "boolean"
        },
        "minimized": {
          "type": "boolean"
        },
        "client_rect": {
          "$ref": "#/definitions/rect"
        }
      },
      "required": [
        "hwnd",
        "pid",
        "client_width",
        "client_height",
        "focused",
        "class",
        "executable",
        "start_ticks",
        "dpi",
        "visible",
        "minimized",
        "client_rect"
      ]
    },
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "calibration_id": {
          "$ref": "#/definitions/id"
        },
        "calibration_sha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "sha256",
        "calibration_id",
        "calibration_sha256"
      ]
    },
    "memory_frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "$ref": "#/definitions/uuid"
        },
        "channel_generation": {
          "$ref": "#/definitions/uuid"
        },
        "host_pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "host_start_ticks": {
          "$ref": "#/definitions/ticks"
        },
        "windows_clock_id": {
          "$ref": "#/definitions/id"
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "frame_id": {
          "$ref": "#/definitions/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "layout_id": {
          "$ref": "#/definitions/sha256"
        },
        "client_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "client_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "dpi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "source_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "request_received_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "roi_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "full_frame_sha256": {
          "type": "null"
        },
        "rois": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/roi"
          }
        },
        "target_scope": {
          "enum": [
            "retail_wow",
            "recording_fixture"
          ]
        }
      },
      "required": [
        "session_id",
        "channel_generation",
        "host_pid",
        "host_start_ticks",
        "windows_clock_id",
        "target",
        "frame_id",
        "seq",
        "layout_id",
        "client_width",
        "client_height",
        "dpi",
        "source_qpc_ms",
        "request_received_qpc_ms",
        "roi_sha256",
        "full_frame_sha256",
        "rois",
        "target_scope"
      ]
    },
    "input_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "cursor_visible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cursor_free": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mouse_buttons_held": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cursor_flags": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "capture_hwnd": {
          "oneOf": [
            {
              "$ref": "#/definitions/hwnd"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_thread_id": {
          "type": "integer",
          "minimum": 0
        },
        "sampled_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "cursor_visible",
        "cursor_free",
        "mouse_buttons_held",
        "cursor_flags",
        "capture_hwnd",
        "target_thread_id",
        "sampled_qpc_ms",
        "reason"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "code"
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "method": {
          "const": "wgc"
        },
        "started_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "finished_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "request_received_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "arrived_qpc_ms": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/definitions/reason"
        },
        "source_qpc_basis": {
          "const": "host_frame_arrived"
        },
        "render_timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "at_ms",
            "alignment"
          ],
          "properties": {
            "domain": {
              "const": "wgc-system-relative"
            },
            "at_ms": {
              "type": "number",
              "minimum": 0
            },
            "alignment": {
              "const": "unverified"
            }
          }
        }
      },
      "required": [
        "status",
        "method",
        "started_qpc_ms",
        "finished_qpc_ms",
        "request_received_qpc_ms",
        "arrived_qpc_ms"
      ]
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "$ref": "#/definitions/reason"
        },
        "calibration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "value",
        "confidence",
        "calibration_id"
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "$ref": "#/definitions/id"
        },
        "intent_id": {
          "$ref": "#/definitions/id"
        },
        "actor": {
          "enum": [
            "code",
            "jev",
            "brain"
          ]
        },
        "plan_id": {
          "$ref": "#/definitions/id"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "task_id": {
          "$ref": "#/definitions/id"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "run_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "gate_id": {
          "$ref": "#/definitions/sha256"
        },
        "action_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "ui_skill": {
          "$ref": "#/definitions/uiSkillDispatch"
        }
      },
      "required": [
        "observation_id",
        "intent_id",
        "actor",
        "plan_id",
        "plan_revision",
        "task_id",
        "task_revision",
        "run_epoch",
        "gate_id",
        "action_sha256"
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "wow-resident"
        },
        "version": {
          "const": 1
        },
        "type": {
          "const": "sample"
        },
        "session_id": {
          "$ref": "#/definitions/uuid"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "$ref": "#/definitions/window"
        },
        "capture": {
          "$ref": "#/definitions/capture"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mean_luma": {
              "type": [
                "number",
                "null"
              ]
            },
            "variance_luma": {
              "type": [
                "number",
                "null"
              ]
            },
            "frame_delta": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "mean_luma",
            "variance_luma",
            "frame_delta"
          ]
        },
        "detectors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inventory_open": {
              "$ref": "#/definitions/detector"
            }
          },
          "required": [
            "inventory_open"
          ]
        },
        "artifact": {
          "type": "null"
        },
        "local_clock": {
          "$ref": "#/definitions/clock"
        },
        "memory_frame": {
          "$ref": "#/definitions/memory_frame"
        },
        "cv": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selected_character": {
              "type": "object"
            },
            "tutorial_interaction": {
              "type": "object"
            },
            "dialog_absence": {
              "type": "object"
            },
            "recording_fixture": {
              "type": "object"
            }
          },
          "required": [
            "selected_character",
            "tutorial_interaction"
          ]
        },
        "input_state": {
          "$ref": "#/definitions/input_state"
        },
        "processing_timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clock": {
              "const": "windows_qpc"
            },
            "request_ms": {
              "type": "number",
              "minimum": 0
            },
            "frame_arrived_ms": {
              "type": "number",
              "minimum": 0
            },
            "roi_started_ms": {
              "type": "number",
              "minimum": 0
            },
            "roi_finished_ms": {
              "type": "number",
              "minimum": 0
            },
            "cv_started_ms": {
              "type": "number",
              "minimum": 0
            },
            "cv_finished_ms": {
              "type": "number",
              "minimum": 0
            },
            "response_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "clock",
            "request_ms",
            "frame_arrived_ms",
            "roi_started_ms",
            "roi_finished_ms",
            "cv_started_ms",
            "cv_finished_ms",
            "response_ms"
          ]
        },
        "ui_skills": {
          "type": "object",
          "required": [
            "status",
            "state_id",
            "confidence",
            "matches",
            "knowledge_sha256",
            "hard_stop",
            "started_qpc_ms",
            "finished_qpc_ms"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "unknown"
              ]
            },
            "state_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "skill_id",
                  "state_id",
                  "signature_id",
                  "status",
                  "hard_stop",
                  "roi_sha256",
                  "scores"
                ],
                "properties": {
                  "skill_id": {
                    "type": "string"
                  },
                  "state_id": {
                    "type": "string"
                  },
                  "signature_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "hard_stop": {
                    "type": "boolean"
                  },
                  "roi_sha256": {
                    "$ref": "#/definitions/sha256"
                  },
                  "scores": {
                    "type": "object"
                  },
                  "current_point": {
                    "type": "object",
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  },
                  "current_rect": {
                    "type": "object",
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "location": {
                    "$ref": "#/definitions/uiNpcLocation"
                  }
                }
              }
            },
            "knowledge_sha256": {
              "$ref": "#/definitions/sha256"
            },
            "hard_stop": {
              "type": "boolean"
            },
            "started_qpc_ms": {
              "type": "number"
            },
            "finished_qpc_ms": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "protocol",
        "version",
        "type",
        "session_id",
        "id",
        "seq",
        "window",
        "capture",
        "metrics",
        "detectors",
        "artifact",
        "local_clock",
        "memory_frame",
        "cv",
        "input_state",
        "processing_timing"
      ]
    },
