{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-jev:knowledge-v2",
  "title": "兼容旧字节的知识快照与严格四层来源",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "sources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/legacy_source"
          },
          {
            "$ref": "#/$defs/layers_source"
          }
        ]
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/fact"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "sources",
    "facts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/legacy_source"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "legacy_source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "kind": {
          "enum": [
            "eye",
            "code_play",
            "jev",
            "brain"
          ]
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "events_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "run_id",
        "kind",
        "mode",
        "manifest_sha256",
        "events_sha256",
        "complete"
      ],
      "additionalProperties": false
    },
    "layers_source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "kind": {
          "const": "layers"
        },
        "mode": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "events_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete": {
          "type": "boolean"
        },
        "world": {
          "type": "object",
          "properties": {
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sqlite_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "manifest_sha256",
            "sqlite_sha256"
          ],
          "additionalProperties": false
        },
        "client_version": {
          "$ref": "urn:wow-jev:game-data-v1#/$defs/version"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "knowledge": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock": {
          "type": "object",
          "properties": {
            "domain": {
              "enum": [
                "simulation-monotonic",
                "coordinator-monotonic"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            }
          },
          "required": [
            "domain",
            "id"
          ],
          "additionalProperties": false
        },
        "supporting_eye": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "events_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "manifest_sha256",
                "events_sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "audit_version": {
          "const": "layer-evidence-v2"
        }
      },
      "required": [
        "id",
        "run_id",
        "kind",
        "mode",
        "manifest_sha256",
        "events_sha256",
        "complete",
        "world",
        "client_version",
        "runtime",
        "knowledge",
        "code_sha256",
        "prompts_sha256",
        "body_profile_sha256",
        "bindings_sha256",
        "calibration_sha256",
        "clock",
        "supporting_eye",
        "audit_version"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "record_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observation_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          }
        },
        "artifact_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
          }
        }
      },
      "required": [
        "source_id",
        "record_seq",
        "observation_ids",
        "artifact_ids"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "kind": {
          "enum": [
            "game_fact",
            "experience",
            "monster_statistic"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "certainty": {
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "scope": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 8000
              }
            ]
          }
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "counterexamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "metrics": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 8000
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "kind",
        "statement",
        "certainty",
        "scope",
        "sample_count",
        "counterexamples",
        "evidence",
        "metrics"
      ],
      "additionalProperties": false
    }
  }
}
