{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-jev:layer-task-world-v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "kind": {
      "const": "kill_count"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "objective_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "world_pack_sha256",
            "quest_key",
            "assertion_sha256",
            "ordinal",
            "native_objective_id"
          ],
          "properties": {
            "world_pack_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "assertion_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "native_objective_id": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "quest_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "kind",
                "native_id"
              ],
              "properties": {
                "namespace": {
                  "type": "string",
                  "pattern": "^(retail|classic-era|classic-progression|classic-seasonal|classic-anniversary|custom:[a-z0-9][a-z0-9_-]{0,63})$"
                },
                "kind": {
                  "const": "quest"
                },
                "native_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        "objective_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "kind",
            "native_id"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^(retail|classic-era|classic-progression|classic-seasonal|classic-anniversary|custom:[a-z0-9][a-z0-9_-]{0,63})$"
            },
            "kind": {
              "const": "creature"
            },
            "native_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "quest_id",
        "count",
        "objective_ref"
      ]
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "urn:wow-jev:layer-behavior-v1#/definitions/behavior"
      }
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "max_behaviors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    }
  },
  "required": [
    "id",
    "revision",
    "kind",
    "params",
    "behaviors",
    "max_duration_ms",
    "max_behaviors"
  ]
}
