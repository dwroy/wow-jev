{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-agent:local-ocr-v1",
  "oneOf": [
    {
      "$ref": "#/definitions/request"
    },
    {
      "$ref": "#/definitions/result"
    }
  ],
  "definitions": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "local-ocr-request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source_observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "captured_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "image_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "roi": {
                "$ref": "#/definitions/rect"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "roi",
              "content_sha256"
            ]
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "frame_id",
        "source_observation_id",
        "captured_at_ms",
        "image_path",
        "image_sha256",
        "width",
        "height",
        "model_id",
        "regions"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "local-ocr-result"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^3\\.9\\.[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "unsupported",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "roi": {
                "$ref": "#/definitions/rect"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "known",
                  "unknown",
                  "unavailable"
                ]
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 65535
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "text",
                    "confidence",
                    "box"
                  ]
                },
                "minItems": 0,
                "maxItems": 256
              },
              "cache_hit": {
                "type": "boolean"
              },
              "parsed_source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request_id",
                  "frame_id",
                  "source_observation_id",
                  "captured_at_ms"
                ],
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "frame_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "source_observation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "captured_at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            "required": [
              "id",
              "roi",
              "content_sha256",
              "status",
              "lines",
              "cache_hit",
              "parsed_source"
            ]
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "version",
        "kind",
        "id",
        "frame_id",
        "image_sha256",
        "model_id",
        "engine_version",
        "status",
        "reason",
        "regions"
      ]
    }
  }
}
