{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-eye:seed-result-v1",
  "title": "Seed低频视觉结果v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "status",
    "model",
    "prompt_sha256",
    "fields",
    "usage",
    "elapsed_ms"
  ],
  "properties": {
    "type": {
      "const": "seed_result"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "ok",
        "disabled",
        "failed"
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "prompt_version": {
      "const": "eye-retail-v1"
    },
    "schema_version": {
      "const": 1
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 16384
        }
      ]
    },
    "fields": {
      "$ref": "#/definitions/fields"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "$ref": "#/definitions/reason"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fields": {
            "$ref": "#/definitions/allFields"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "maxProperties": 0
          },
          "reason": {
            "$ref": "#/definitions/reason"
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  ],
  "definitions": {
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "baseField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "unavailable"
          ]
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "$ref": "#/definitions/reason"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "null"
              },
              "confidence": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "nameField": {
      "allOf": [
        {
          "$ref": "#/definitions/baseField"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "summaryField": {
      "allOf": [
        {
          "$ref": "#/definitions/baseField"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "boolField": {
      "allOf": [
        {
          "$ref": "#/definitions/baseField"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "levelField": {
      "allOf": [
        {
          "$ref": "#/definitions/baseField"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              }
            }
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "player.name": {
          "$ref": "#/definitions/nameField"
        },
        "player.level": {
          "$ref": "#/definitions/levelField"
        },
        "target.present": {
          "$ref": "#/definitions/boolField"
        },
        "target.name": {
          "$ref": "#/definitions/nameField"
        },
        "player.in_combat": {
          "$ref": "#/definitions/boolField"
        },
        "scene.summary": {
          "$ref": "#/definitions/summaryField"
        },
        "ui.inventory_open": {
          "$ref": "#/definitions/boolField"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "target.name": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "known"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "target.name"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "target.present": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "known"
                  },
                  "value": {
                    "const": true
                  }
                },
                "required": [
                  "status",
                  "value"
                ]
              }
            },
            "required": [
              "target.present"
            ]
          }
        }
      ]
    },
    "allFields": {
      "type": "object",
      "properties": {
        "player.name": {
          "$ref": "#/definitions/nameField"
        },
        "player.level": {
          "$ref": "#/definitions/levelField"
        },
        "target.present": {
          "$ref": "#/definitions/boolField"
        },
        "target.name": {
          "$ref": "#/definitions/nameField"
        },
        "player.in_combat": {
          "$ref": "#/definitions/boolField"
        },
        "scene.summary": {
          "$ref": "#/definitions/summaryField"
        },
        "ui.inventory_open": {
          "$ref": "#/definitions/boolField"
        }
      },
      "required": [
        "player.name",
        "player.level",
        "target.present",
        "target.name",
        "player.in_combat",
        "scene.summary",
        "ui.inventory_open"
      ]
    }
  }
}
