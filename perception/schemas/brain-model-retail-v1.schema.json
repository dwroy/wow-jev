{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "plan_revision",
    "route_id",
    "evidence_observation_id",
    "consulted_fact_ids",
    "reason"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "consulted_fact_ids": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-brain:model-retail-v1"
}
