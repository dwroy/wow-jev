{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wow-jev/session-recovery-v1",
  "description": "Bounded Windows session-1 recovery bridge. Requests contain no shell, arbitrary launch path, launch arguments, credential text, or effect-success claim.",
  "definitions": {
    "blocked_auth_token": {"type": "string", "enum": ["密码", "验证码", "验证", "身份验证", "安全令牌", "Password", "Authenticator", "Verification"]},
    "auth_context_token": {"type": "string", "enum": ["账号", "帐号", "账户", "登录", "登陆", "Login", "Account"]},
    "reconnect_state_token": {"type": "string", "enum": ["确定", "断开", "已从服务器断开", "断开连接", "断线", "已断开", "连接丢失", "重连", "重新连接", "WOW51900319", "Reconnect", "Disconnected"]},
    "blocked_terms_token": {"type": "string", "enum": ["协议", "同意", "许可", "Agreement"]},
    "blocked_update_token": {"type": "string", "enum": ["更新", "安装", "下载", "修复", "扫描", "Update", "Install", "Download"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["pid", "start_ticks", "hwnd", "class", "executable"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "start_ticks": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "hwnd": {"type": "string", "pattern": "^0x[0-9a-fA-F]{1,16}$"},
        "class": {"type": "string", "minLength": 1, "maxLength": 1024},
        "executable": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "capture_sha256", "width", "height", "observation_path"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1, "maximum": 65536},
        "height": {"type": "integer", "minimum": 1, "maximum": 65536},
        "observation_path": {"type": "string", "minLength": 1}
      }
    },
    "recovery_focus_point_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed",
        "reason",
        "hwnd",
        "checked_at_ms",
        "visible",
        "minimized",
        "focused",
        "point",
        "patch_radius",
        "on_monitor",
        "point_owned",
        "point_visible",
        "cursor_free",
        "mouse_buttons_held",
        "idle_threshold_ms",
        "user_idle_scope",
        "input_source_distinguishable",
        "visibility_method",
        "owned_click_started"
      ],
      "properties": {
        "mode": {
          "const": "visible_point"
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "hwnd": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{1,16}$"
        },
        "checked_at_ms": {
          "type": "number",
          "minimum": 0
        },
        "visible": {
          "type": "boolean"
        },
        "minimized": {
          "type": "boolean"
        },
        "focused": {
          "type": "boolean"
        },
        "on_monitor": {
          "type": "boolean"
        },
        "point_owned": {
          "type": "boolean"
        },
        "point_visible": {
          "type": "boolean"
        },
        "cursor_free": {
          "type": "boolean"
        },
        "mouse_buttons_held": {
          "type": "boolean"
        },
        "input_source_distinguishable": {
          "type": "boolean"
        },
        "owned_click_started": {
          "type": "boolean"
        },
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "screen_point": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          }
        },
        "patch_screen_rect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "top",
            "right",
            "bottom"
          ],
          "properties": {
            "left": {
              "type": "integer"
            },
            "top": {
              "type": "integer"
            },
            "right": {
              "type": "integer"
            },
            "bottom": {
              "type": "integer"
            }
          }
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": "integer",
          "minimum": 0
        },
        "probe_session_id": {
          "type": "integer",
          "minimum": 0
        },
        "client_width": {
          "type": "integer",
          "minimum": 0
        },
        "client_height": {
          "type": "integer",
          "minimum": 0
        },
        "last_input_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "current_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "user_idle_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "class": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "process_name": {
          "type": "string"
        },
        "failure_detail": {
          "type": "string"
        },
        "process_start_ticks": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "patch_radius": {
          "const": 2
        },
        "idle_threshold_ms": {
          "const": 5000
        },
        "user_idle_scope": {
          "const": "calling-session-only"
        },
        "visibility_method": {
          "const": "physical_patch_monitor_union_and_each_pixel_root_hit_test"
        }
      }
    },
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "keys", "duration_ms"], "properties": {"kind": {"const": "key"}, "keys": {"type": "array", "minItems": 1, "maxItems": 60, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[A-Z0-9]|F(?:[1-9]|1[0-2])|SPACE|SHIFT|CTRL|ALT|ESC|TAB|ENTER|BACKSPACE|UP|DOWN|LEFT|RIGHT)$"}}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 150}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "button", "x", "y", "duration_ms"], "properties": {"kind": {"const": "mouse_click"}, "button": {"enum": ["left", "right", "middle"]}, "x": {"type": "integer", "minimum": 0, "maximum": 65535}, "y": {"type": "integer", "minimum": 0, "maximum": 65535}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 150}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "x", "y", "duration_ms"], "properties": {"kind": {"const": "focus_click"}, "visibility_mode": {"type":"string", "enum":["complete_client", "visible_point"]}, "x": {"type": "integer", "minimum": 0, "maximum": 65535}, "y": {"type": "integer", "minimum": 0, "maximum": 65535}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 150}}}
      ]
    },
    "request": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["version", "op"], "properties": {"version": {"const": 1}, "op": {"enum": ["discover", "launch_battlenet"]}}},
        {"type": "object", "additionalProperties": false, "required": ["version", "op", "target"], "properties": {"version": {"const": 1}, "op": {"const": "observe"}, "target": {"$ref": "#/definitions/target"}}},
        {"type": "object", "additionalProperties": false, "required": ["version", "op", "target", "source", "action"], "properties": {"version": {"const": 1}, "op": {"const": "input"}, "target": {"$ref": "#/definitions/target"}, "source": {"$ref": "#/definitions/source"}, "action": {"$ref": "#/definitions/action"}}},
        {"type": "object", "additionalProperties": false, "required": ["version", "op", "target", "source"], "properties": {"version": {"const": 1}, "op": {"const": "launch_wow"}, "target": {"$ref": "#/definitions/target"}, "source": {"$ref": "#/definitions/source"}}}
      ]
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "width", "height", "started_windows_qpc_ms", "finished_windows_qpc_ms", "method"],
      "properties": {
        "file": {"const": "client.png"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "started_windows_qpc_ms": {"type": "number", "minimum": 0}, "finished_windows_qpc_ms": {"type": "number", "minimum": 0},
        "method": {"enum": ["PrintWindow-client-renderfullcontent", "CopyFromScreen-client-visible"]}
      }
    },
    "ocr": {
      "type": "object", "required": ["status", "items", "raw_text_retained"],
      "properties": {
        "status": {"enum": ["available", "unknown"]}, "raw_text_retained": {"const": false},
        "items": {"type": "array", "items": {"type": "object", "required": ["text", "x", "y", "width", "height"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 64}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}}
      }
    },
    "result": {
      "type": "object", "required": ["schema_version", "status", "session_id", "input_sent", "release_confirmed", "effect_status"],
      "properties": {
        "schema_version": {"const": 1}, "session_id": {"const": 1},
        "status": {"enum": ["discovered", "observed", "input_released", "launched", "blocked", "cancelled"]},
        "reason": {"type": "string"}, "input_sent": {"type": "boolean"}, "release_confirmed": {"type": "boolean"},
        "effect_status": {"const": "unknown"}, "window": {"type":"object", "properties":{"recovery_focus_candidates":{"type":"array", "maxItems":4, "items":{"$ref":"#/definitions/recovery_focus_point_safety"}}}}, "target": {"$ref": "#/definitions/target"}, "capture": {"$ref": "#/definitions/capture"}, "ocr": {"$ref": "#/definitions/ocr"},
        "launch_requested": {"type": "boolean"}, "launch_effect": {"const": "unknown"}, "wow_process_started_confirmed": {"const": false}, "world_entered": {"const": false},
        "started_windows_qpc_ms": {"type": "number", "minimum": 0}, "finished_windows_qpc_ms": {"type": "number", "minimum": 0},
        "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "selected_character": {"type": "object", "required": ["verified", "source", "reason"], "properties": {"verified": {"type": "boolean"}, "source": {"const": "calibrated_cv"}, "reason": {"type": "string"}, "name": {"const": "小啊"}, "class": {"const": "warrior"}, "faction": {"const": "alliance"}, "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    }
  }
}
