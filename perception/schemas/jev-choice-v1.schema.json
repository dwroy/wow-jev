{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "status",
    "candidate_id",
    "reason",
    "model",
    "prompt_version",
    "prompt_sha256",
    "elapsed_ms",
    "usage",
    "raw_text"
  ],
  "properties": {
    "type": {
      "const": "jev_choice"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "disabled"
      ]
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      ]
    },
    "prompt_version": {
      "const": "jev-retail-v1"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "model": {
            "const": "doubao-seed-2-0-mini-260428"
          },
          "raw_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        }
      },
      "else": {
        "properties": {
          "candidate_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wow-jev:choice-v1",
  "title": "Jev bounded choice worker result and request v1",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "type",
        "id",
        "plan",
        "goal",
        "based_on_observation_id",
        "window_token",
        "at_ms",
        "deadline_ms",
        "candidates_sha256",
        "candidates"
      ],
      "properties": {
        "protocol": {
          "const": "wow-jev"
        },
        "version": {
          "const": 1
        },
        "type": {
          "const": "selection_request"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision",
            "description",
            "mode",
            "allow_movement",
            "allowed_action_slots",
            "target_signature"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "mode": {
              "enum": [
                "observe",
                "practice"
              ]
            },
            "allow_movement": {
              "type": "boolean"
            },
            "allowed_action_slots": {
              "type": "array",
              "maxItems": 60,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "target_signature": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            }
          }
        },
        "based_on_observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "window_token": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "summary",
              "step",
              "conditions",
              "target_signature"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "step": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "duration_ms"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "name": {
                        "const": "wait"
                      },
                      "duration_ms": {
                        "const": 250
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "duration_ms"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "name": {
                        "const": "move_for"
                      },
                      "duration_ms": {
                        "const": 100
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "dx",
                      "duration_ms"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "name": {
                        "const": "turn_for"
                      },
                      "dx": {
                        "enum": [
                          -40,
                          40
                        ]
                      },
                      "duration_ms": {
                        "const": 200
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "slot",
                      "duration_ms"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "name": {
                        "const": "use_action_slot"
                      },
                      "slot": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "duration_ms": {
                        "const": 100
                      }
                    }
                  }
                ]
              },
              "conditions": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "op",
                    "value",
                    "max_age_ms"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "capture.available",
                        "window.focused",
                        "target.present",
                        "target.dead",
                        "target.signature",
                        "player.in_combat"
                      ]
                    },
                    "op": {
                      "const": "eq"
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      ]
                    },
                    "max_age_ms": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 750
                    }
                  }
                }
              },
              "target_signature": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
